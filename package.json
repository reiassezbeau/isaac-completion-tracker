{
  "name": "isaac-completion-tracker",
  "private": true,
  "version": "0.4.7",
  "type": "module",
  "description": "Local, offline completion tracker for The Binding of Isaac: Repentance+",
  "author": "reiassezbeau (https://github.com/reiassezbeau)",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/reiassezbeau/isaac-completion-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/reiassezbeau/isaac-completion-tracker"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:knowledge": "tsx tools/build-knowledge/build.ts",
    "build:item-kb": "tsx tools/build-knowledge/build-item-kb.ts",
    "build:item-names": "tsx tools/build-knowledge/build-item-names.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "python tools/audit.py",
    "check": "npm run audit && tsc --noEmit && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^2.1.9"
  }
}
